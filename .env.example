# All keys are read server-side only, except the NEXT_PUBLIC_* analytics keys.

# Optional. Without it, TrustLayer runs in deterministic (offline) mode:
# the heuristic classifier and templated generators are used instead of the model.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional product analytics. If unset, events are kept in an in-app buffer only.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
